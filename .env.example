# =========================================================
# .env.example
# انسخ هذا الملف وسمّه .env وضع فيه القيم الحقيقية
# لا ترفع ملف .env الحقيقي إلى GitHub أبداً
# =========================================================

# الخيار الأول (يُفضَّل على Railway): رابط اتصال كامل بقاعدة بيانات MySQL
# على Railway: يوفّرها لك تلقائياً بعد إنشاء قاعدة بيانات MySQL في نفس المشروع
# محلياً مثال: mysql://root:1234@localhost:3306/qayrawan_club
DATABASE_URL=mysql://root:password@localhost:3306/qayrawan_club

# الخيار الثاني (بديل، يُستخدم تلقائياً فقط إذا لم تضع DATABASE_URL أعلاه):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=qayrawan_club

# منفذ التشغيل (Railway يضبطه تلقائياً، محلياً اتركه 3000)
PORT=3000

# مفتاح تشفير الجلسات - غيّره لقيمة عشوائية طويلة قبل النشر
SESSION_SECRET=change-this-to-a-long-random-string

# رمز دخول الإدارة (تحكم كامل) — اختر رقماً سرياً خاصاً بك، لا تستخدم هذه القيمة كما هي
ADMIN_ACCESS_CODE=change-this-admin-code

# رمز دخول المشرفين (تحضير + نقاط مبادرة فقط) — اختر رقماً سرياً خاصاً بك، لا تستخدم هذه القيمة كما هي
SUPERVISOR_ACCESS_CODE=change-this-supervisor-code

# development أو production
NODE_ENV=development

# =========================================================
# WhatsApp Business Cloud API (Meta) — لإرسال تذكير نهاية الأسبوع تلقائياً
# اتركها فارغة إذا لم تُنشئ الحساب بعد؛ الموقع سيعمل بدونها (يبقى زر wa.me اليدوي فقط)
# =========================================================
# رمز الوصول (Access Token) من Meta for Developers > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=

# معرّف الرقم (Phone Number ID) بعد ربط رقمك في WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=

# اسم القالب (Template) المعتمَد من Meta لرسالة التذكير — يجب أن يحتوي 4 متغيرات بهذا الترتيب:
# {{1}} اسم الطالب  {{2}} اسم الأسرة  {{3}} سبب التذكير  {{4}} رقم الأسبوع
WHATSAPP_TEMPLATE_NAME=

# رمز لغة القالب كما سجّلته في Meta (عادة ar)
WHATSAPP_TEMPLATE_LANG=ar
